# Environment variables for exposure-inspection-agent
# Copy this file to .env and fill in real values.
# NEVER commit .env to git - it contains secrets.

# ============================================================
# OctoBus Gateway Configuration
# ============================================================
# OctoBus endpoint - bind to 127.0.0.1, never expose to public internet
# In docker-compose, use the service name as hostname
OCTOBUS_ENDPOINT=http://127.0.0.1:9000

# Capset access token - generated when creating the capset in OctoBus
# This token grants access only to methods defined in the capset (least privilege)
OCTOBUS_CAPSET_TOKEN=your-capset-token-here

# ============================================================
# LLM Model Configuration (OpenAI-compatible API)
# ============================================================
# API endpoint - any OpenAI-compatible provider works
LLM_API_BASE=https://api.openai.com
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# ============================================================
# Agent Configuration
# ============================================================
ASSET_INVENTORY_PATH=/data/assets.csv
OUTPUT_DIR=/data/output
KNOWLEDGE_DIR=/app/knowledge
SCAN_TIMEOUT=10
SCAN_CONCURRENCY=5

# ============================================================
# AssetQuery Service (OctoBus backend)
# ============================================================
ASSET_DATA_PATH=/data/assets.json

# ============================================================
# Network Configuration
# ============================================================
# Docker network shared between agent-compose and OctoBus
DOCKER_NETWORK=agent-net
