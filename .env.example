# Environment variables for exposure-inspection-agent
# Copy this file to .env and fill in real values.
# NEVER commit .env to git - it contains secrets.
#
# In production, this .env sits next to agent-compose.yml in the daemon's
# working directory (/opt/agent-compose/data/work/.env on the server).
# The daemon injects these into each sandbox run via env_file.

# ============================================================
# OctoBus Gateway Configuration (Connect RPC over HTTP)
# ============================================================
# OctoBus endpoint reachable from the agent sandbox.
# In the agent-compose sandbox use the docker network DNS name;
# for local runs use 127.0.0.1 (never expose OctoBus to public internet).
OCTOBUS_ENDPOINT=http://octobus:9000

# Capability set (method-level whitelist) granted to this agent
OCTOBUS_CAPSET=exposure-scan

# Capset access token - issued by OctoBus admin:
#   octobus capset add-token exposure-scan inspector-agent --token <TOKEN>
OCTOBUS_CAPSET_TOKEN=your-capset-token-here

# Service instances and full method paths as registered in OctoBus
OCTOBUS_PORTSCAN_INSTANCE=portscan-default
OCTOBUS_PORTSCAN_METHOD=portscan.v1.PortScanService/ScanPorts
OCTOBUS_ASSETQUERY_INSTANCE=assetquery-default
OCTOBUS_ASSETQUERY_METHOD=assetquery.v1.AssetQueryService/QueryAssets

# Per-request timeout in seconds. Unroutable hosts need a full scan
# window, but OctoBus on-demand invokes enforce ~30s server-side,
# so keep scan_timeout small enough to fit (see SCAN_TIMEOUT below).
OCTOBUS_TIMEOUT=90

# ============================================================
# LLM Model Configuration (OpenAI-compatible API)
# ============================================================
# Optional: when LLM_API_KEY is empty the agent skips LLM fuzzy
# judgment and the deterministic rule engine completes the cycle
# (graceful degradation - inspection never blocks on LLM availability).
#
# LLM_API_BASE must point at the SERVICE ROOT (no /chat/completions):
#   OpenAI          : https://api.openai.com/v1
#   Volcengine Ark  : https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL is the Ark inference endpoint ID (ep-xxx, created in the
# Ark console under 模型推理 -> 推理接入点) or an activated model ID.
LLM_API_BASE=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
LLM_MODEL=ep-your-endpoint-id

# ============================================================
# Agent Configuration
# ============================================================
# Inside the agent-compose sandbox the workspace snapshot root is /workspace
# and persistent output lives on the inspection-output volume at /output.
ASSET_INVENTORY_PATH=/workspace/sample-data/assets.json
OUTPUT_DIR=/output
KNOWLEDGE_DIR=/workspace/knowledge

# 2s per port + bounded concurrency keeps full-list scans of unreachable
# hosts inside the OctoBus on-demand invoke deadline (~30s server-side).
SCAN_TIMEOUT=2
SCAN_CONCURRENCY=8

# ============================================================
# AssetQuery Service (OctoBus backend, server-side only)
# ============================================================
ASSET_DATA_PATH=/data/assets.json
